---
// Stripe Checkout redirects here after a successful payment
// (success_url in supabase/functions/create-checkout-session). Every locale
// the checkout can run in needs a page under <locale>/thanks/.
import Layout from '../layouts/Layout.astro';
import { Footer } from './Footer.tsx';
import { getLocalizedPath, getTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang).thanks;
---

<Layout pageKey="thanks" currentPage="" lang={lang} noindex={true}>
  <div class="flex-1 flex flex-col items-center justify-center p-6 md:p-12 lg:p-24 text-center">
    <div class="max-w-3xl mx-auto space-y-8 animate-in fade-in zoom-in duration-700">

      <div class="w-24 h-24 bg-emerald-500/10 rounded-full flex items-center justify-center mx-auto mb-8 border border-emerald-500/20 shadow-[0_0_30px_rgba(16,185,129,0.2)]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <div class="space-y-4">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4">
          {t.title}
        </h1>
        <h2 class="text-xl md:text-2xl font-bold text-zinc-200">
          {t.subtitle}
        </h2>
      </div>

      <p class="text-lg md:text-xl text-zinc-400 font-medium leading-relaxed max-w-2xl mx-auto mt-6">
        {t.message}
      </p>

      <div class="pt-8">
        <a
          href={getLocalizedPath('/', lang)}
          class="inline-flex h-12 items-center justify-center rounded-full bg-emerald-500 px-8 py-3 text-base font-bold text-zinc-950 transition-transform hover:scale-105 hover:bg-emerald-600 gap-2 shadow-lg shadow-emerald-500/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          {t.backHome}
        </a>
      </div>

    </div>
  </div>

  <Footer client:visible slot="footer" lang={lang} showNewsletter={false} />

  <!-- Clear cart after successful checkout -->
  <script is:inline>
    try {
      Object.keys(localStorage).forEach(function(key) {
        if (key.startsWith('cart:')) localStorage.removeItem(key);
      });
      if (window.umami) window.umami.track('purchase-complete');
    } catch (e) {}
  </script>
</Layout>
